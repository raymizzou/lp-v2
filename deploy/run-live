#!/usr/bin/env bash
# DRAFT. A future explicitly authorized live launch; this script provisions nothing.
set -euo pipefail
release=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
markets=${LP_V2_MARKETS-${LP_V2_MARKET:-}}
[[ -n "$markets" && "$markets" != ,* && "$markets" != *, && "$markets" != *,,* ]] || { echo 'Set 1–3 approved LP_V2_MARKETS' >&2; exit 2; }
IFS=, read -r -a ids <<< "$markets"
args=()
for id in "${ids[@]}"; do args+=(--market "$id"); done
exec "$release/.venv/bin/lp-v2" run --live \
  --capital-usdc "${LP_V2_CAPITAL_USDC:?set approved frozen capital}" \
  "${args[@]}" \
  --code-sha "${LP_V2_CODE_SHA:?set the exact approved release SHA}" \
  --private-key-file /etc/lp-v2/signing-key \
  --credentials-file /etc/lp-v2/credentials.json \
  --relayer-credentials-file /etc/lp-v2/relayer.json \
  --state-dir /opt/lp-v2/state
